---
import BaseLayout from './BaseLayout.astro';
import { formatDate, tagSlug } from '../lib/site';

const { frontmatter } = Astro.props;
const isRu = Astro.url.pathname.startsWith('/ru');
const locale = isRu ? 'ru' : 'en';
const prefix = isRu ? '/ru' : '';
const image = frontmatter.image?.url ?? frontmatter.image?.src;
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  image={image}
  imageAlt={frontmatter.image?.alt}
  ogType="article"
  hideTitle
  fullWidth
>
  <article class="article column">
    <header class="post-header">
      <h1 class="post-title">{frontmatter.title}</h1>
      <p class="post-subtitle">{frontmatter.description}</p>
      <p class="post-meta">
        <time datetime={frontmatter.pubDate.toISOString()}>{formatDate(frontmatter.pubDate, locale)}</time>
        <span aria-hidden="true"> · </span>
        <span>{frontmatter.author}</span>
      </p>
      {frontmatter.tags?.length > 0 && (
        <ul class="post-tags" aria-label={isRu ? 'Теги' : 'Tags'}>
          {frontmatter.tags.map((tag: string) => (
            <li><a href={`${prefix}/tags/${tagSlug(tag)}/`}>{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a class="back-link" href={`${prefix}/blog/`}>← {isRu ? 'Все посты' : 'All posts'}</a>
    </footer>
  </article>
</BaseLayout>
