---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = await getCollection('postsRu');
---

<BaseLayout pageTitle="Блог" description="Мысли о разработке программного обеспечения, реверс-инжиниринге и создании вещей.">
  <p class="page-intro">Мысли о разработке программного обеспечения, реверс-инжиниринге и создании вещей. Посты по <a class="text-link" href="/ru/tags/">тегам</a>.</p>
  <PostList posts={posts} base="/ru/postsRu/" locale="ru" />
</BaseLayout>
