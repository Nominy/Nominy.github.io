---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

const posts = await getCollection('postsRu');
---

<BaseLayout description="Naft San — инженер, реверс-инженер, создатель.">
  <section class="home-intro">
    <h1 class="page-title">Naft San — инженер, реверс-инженер, создатель.</h1>
    <p class="page-intro">
      Заметки о машинном обучении, реверс-инжиниринге и вещах, которые я делаю. Подробнее <a class="text-link" href="/ru/about/">обо мне</a>.
    </p>
  </section>

  <h2 class="section-label">Посты</h2>
  <PostList posts={posts} base="/ru/postsRu/" locale="ru" headingLevel={3} />
</BaseLayout>
