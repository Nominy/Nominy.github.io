---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { tagSlug } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('postsRu');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout pageTitle={`Тег «${tag}»`}>
  <PostList posts={posts} base="/ru/postsRu/" locale="ru" />
  <p class="mt-10"><a class="back-link" href="/ru/tags/">← Все теги</a></p>
</BaseLayout>
