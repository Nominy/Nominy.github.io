---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tagSlug } from '../../../lib/site';

const posts = await getCollection('postsRu');
const counts = new Map<string, number>();
for (const tag of posts.flatMap((post) => post.data.tags)) {
  counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout pageTitle="Теги">
  <ul class="tag-list">
    {tags.map(([tag, count]) => (
      <li>
        <a href={`/ru/tags/${tagSlug(tag)}/`}>{tag}</a>
        <span class="count">{count}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
