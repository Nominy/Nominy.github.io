---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  { title: 'RimMercenaries', year: '2025', desc: '14k+ просмотров, 3.5k+ подписчиков. Сложные системы на C#, улучшения XML для мода RimWorld.' },
  { title: 'Hidden-Bat Detector', year: '2023', desc: 'Дообученный ResNet50 на синтетических данных; точность 35% pass@1 с использованием PyTorch.' },
  { title: 'Payday 3 Audio Mod', year: '2025', desc: 'Реверс-инжиниринг аудио через Wwise API с использованием UE4SS.' },
  { title: 'vk-kiriban-catcher', year: '2024', desc: 'Трекер вех VK в реальном времени с WebSockets на Next.js.' },
  { title: 'io scene mdl', year: '2023', desc: 'Импортер/экспортер формата .mdl как аддон для Blender.' },
];
---

<BaseLayout pageTitle="Обо мне" description="Naft San — инженер-программист из Украины: ИИ, веб, моддинг игр и реверс-инжиниринг.">
  <div class="prose">
    <p>
      Отмеченный наградами инженер-программист из Украины, получаю степень в области компьютерных наук в Техническом университете Кошице. Специализируюсь на Python, JS, C#, Lua для ИИ, веб-разработки и модификации игр. Эксперт по реверс-инжинирингу. Участник проектов с открытым исходным кодом, победитель региональной олимпиады по информатике.
    </p>
    <p class="ui text-base">
      <a href="mailto:sapkovich.vladislav@gmail.com">Написать мне</a>
      <span class="muted"> · </span>
      <a href="https://github.com/Nominy" rel="me noopener">GitHub</a>
      <span class="muted"> · </span>
      <a href="/assets/resume.pdf">Скачать резюме</a>
    </p>

    <h2>Навыки</h2>
    <ul class="entries">
      <li><span class="entry-title">Языки и фреймворки</span><span class="entry-desc">Python, PyTorch, C#, Lua, JS/TypeScript (React, Next.js, Svelte, Express.js), GDScript, C++</span></li>
      <li><span class="entry-title">Инструменты и платформы</span><span class="entry-desc">Unity, Unreal Engine 4 (UE4SS), Blender API, SQLite, GitHub Actions, Linux</span></li>
    </ul>

    <h2>Ключевые проекты</h2>
    <ul class="entries">
      {projects.map((project) => (
        <li>
          <span class="entry-title">{project.title}</span><span class="entry-year">{project.year}</span>
          <span class="entry-desc">{project.desc}</span>
        </li>
      ))}
    </ul>

    <h2>Образование и награды</h2>
    <ul class="entries">
      <li><span class="entry-title">Золотая медаль</span><span class="entry-desc">Экономический лицей Одессы, 2025 (средний балл 4.9/5)</span></li>
      <li><span class="entry-title">Победитель олимпиады по информатике</span><span class="entry-desc">Одесская область (Python), 2023 и 2024</span></li>
    </ul>

    <h2>Сообщество</h2>
    <p>Участник проектов GitHub для разработчиков и библиотек алгоритмов. Волонтёр DevOps и Lua-разработчик на сервере Crystal Horizons GMod (2024–2025).</p>
    <p>Обучил 30+ студентов программированию, математике и физике.</p>

    <h2>Языки и интересы</h2>
    <ul class="entries">
      <li><span class="entry-title">Языки</span><span class="entry-desc"><strong>Свободно:</strong> Английский, Украинский, Русский. <strong>Средний уровень:</strong> Немецкий, Словацкий. <strong>Базовый:</strong> Китайский, Испанский.</span></li>
      <li><span class="entry-title">Интересы</span><span class="entry-desc">Реверс-инжиниринг, интерпретируемость ИИ, процедурная генерация, визуализация алгоритмов</span></li>
    </ul>
  </div>
</BaseLayout>
