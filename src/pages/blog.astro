---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const posts = await getCollection('posts');
---

<BaseLayout pageTitle="Blog" description="Writing on machine learning, reverse engineering and building things.">
  <p class="page-intro">Writing on machine learning, reverse engineering and building things. Browse by <a class="text-link" href="/tags/">tag</a>.</p>
  <PostList posts={posts} base="/posts/" />
</BaseLayout>
