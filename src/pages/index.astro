---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

const posts = await getCollection('posts');
---

<BaseLayout>
  <section class="home-intro">
    <h1 class="page-title">Naft San — engineer, reverse engineer, builder.</h1>
    <p class="page-intro">
      Notes on machine learning, reverse engineering and the things I build. More <a class="text-link" href="/about/">about me</a>.
    </p>
  </section>

  <h2 class="section-label">Writing</h2>
  <PostList posts={posts} base="/posts/" headingLevel={3} />
</BaseLayout>
