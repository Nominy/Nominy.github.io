---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  { title: 'RimMercenaries', year: '2025', desc: '14k+ views, 3.5k+ subscribers. Complex C# systems, XML enhancements for RimWorld mod.' },
  { title: 'Hidden-Bat Detector', year: '2023', desc: 'ResNet50 fine-tuned on synthetic data; 35% pass@1 accuracy using PyTorch.' },
  { title: 'Payday 3 Audio Mod', year: '2025', desc: 'Reverse-engineered audio via Wwise API using UE4SS.' },
  { title: 'vk-kiriban-catcher', year: '2024', desc: 'Real-time VK milestone tracker with WebSockets built in Next.js.' },
  { title: 'io scene mdl', year: '2023', desc: 'Reverse-engineered .mdl format importer/exporter as Blender Addon.' },
];
---

<BaseLayout pageTitle="About" description="Naft San — software engineer from Ukraine: AI, web, game modding and reverse engineering.">
  <div class="prose">
    <p>
      Award-winning software engineer from Ukraine, pursuing Computer Science at Technical University of Košice. Specialize in Python, JS, C#, Lua for AI, web, and game modding. Expert in reverse engineering. Open-source contributor, regional CS Olympiad winner.
    </p>
    <p class="ui text-base">
      <a href="mailto:sapkovich.vladislav@gmail.com">Email me</a>
      <span class="muted"> · </span>
      <a href="https://github.com/Nominy" rel="me noopener">GitHub</a>
      <span class="muted"> · </span>
      <a href="/assets/resume.pdf">Download CV</a>
    </p>

    <h2>Skills</h2>
    <ul class="entries">
      <li><span class="entry-title">Languages & Frameworks</span><span class="entry-desc">Python, PyTorch, C#, Lua, JS/TypeScript (React, Next.js, Svelte, Express.js), GDScript, C++</span></li>
      <li><span class="entry-title">Tools & Platforms</span><span class="entry-desc">Unity, Unreal Engine 4 (UE4SS), Blender API, SQLite, GitHub Actions, Linux</span></li>
    </ul>

    <h2>Key Projects</h2>
    <ul class="entries">
      {projects.map((project) => (
        <li>
          <span class="entry-title">{project.title}</span><span class="entry-year">{project.year}</span>
          <span class="entry-desc">{project.desc}</span>
        </li>
      ))}
    </ul>

    <h2>Education & Honors</h2>
    <ul class="entries">
      <li><span class="entry-title">Gold Medal Graduate</span><span class="entry-desc">Economic Lyceum of Odesa, 2025 (GPA 4.9/5)</span></li>
      <li><span class="entry-title">CS Olympiad Winner</span><span class="entry-desc">Odesa Region (Python), 2023 & 2024</span></li>
    </ul>

    <h2>Community</h2>
    <p>Contributor to GitHub developer tools and algorithm libraries. Volunteer DevOps & Lua Developer at Crystal Horizons GMod Server (2024–2025).</p>
    <p>Tutored 30+ students in programming, math, and physics.</p>

    <h2>Languages & Interests</h2>
    <ul class="entries">
      <li><span class="entry-title">Languages</span><span class="entry-desc"><strong>Fluent:</strong> English, Ukrainian, Russian. <strong>Intermediate:</strong> German, Slovak. <strong>Basic:</strong> Chinese, Spanish.</span></li>
      <li><span class="entry-title">Interests</span><span class="entry-desc">Reverse Engineering, AI Interpretability, Procedural Generation, Algorithm Visualization</span></li>
    </ul>
  </div>
</BaseLayout>
