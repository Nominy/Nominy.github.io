---
import { SITE_TITLE } from '../lib/site';
import { localeAlternates } from '../lib/i18n';

const pathname = Astro.url.pathname;
const isRu = pathname.startsWith('/ru');
const prefix = isRu ? '/ru' : '';
const alternates = await localeAlternates(pathname);
// Pages without a translation link to the other language's blog index.
const switchHref = isRu ? alternates.en ?? '/blog/' : alternates.ru ?? '/ru/blog/';

const links = [
  { href: `${prefix}/blog/`, label: isRu ? 'Блог' : 'Blog' },
  { href: `${prefix}/about/`, label: isRu ? 'Обо мне' : 'About' },
];
const current = pathname.endsWith('/') ? pathname : `${pathname}/`;
---

<header class="site-header">
  <nav class="column" aria-label={isRu ? 'Основная навигация' : 'Main'}>
    <a href={isRu ? '/ru/' : '/'} class="site-name">{SITE_TITLE}</a>
    <div class="site-links">
      {links.map((link) => (
        <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href={switchHref} hreflang={isRu ? 'en' : 'ru'} lang={isRu ? 'en' : 'ru'} aria-label={isRu ? 'English version' : 'Русская версия'}>
        {isRu ? 'EN' : 'RU'}
      </a>
    </div>
  </nav>
</header>
